<Window x:Class="StartUPs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartUPs"
        mc:Ignorable="d"
        Title="StartUPs" Height="720" Width="1080"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBg}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}">
                        <Run Text="Start"/><Run Text="UPs" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <TextBlock Text="Pick your apps. Install them all at once."
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid x:Name="SearchArea" Grid.Column="1" Width="260" VerticalAlignment="Center">
                    <TextBox x:Name="SearchInput"
                             Style="{StaticResource SearchBox}"
                             TextChanged="SearchInput_TextChanged"/>
                    <TextBlock Text="Search apps..." FontSize="13" Margin="12,0,0,0"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== BODY ==================== -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
                <ListBox x:Name="CategoryList"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,12"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         SelectionChanged="CategoryList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- The sidebar is disabled during a run so the selection cannot
                         change mid-install. WPF's stock ListBox template repaints
                         itself with the system "control" and "grey text" colours when
                         disabled, which turns the sidebar white on a dark theme.
                         Redirecting those two keys keeps it looking like itself. -->
                    <ListBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF8A8A99"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- App list -->
            <ScrollViewer x:Name="AppScroller" Grid.Column="1" Margin="20,16,12,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AppList" Margin="0,0,10,0">
                    <!-- Cards flow into as many columns as the window is wide.
                         When grouping is on this panel lays out the cards inside
                         each category; GroupStyle.Panel below stacks the groups. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource AppCard}"
                                      Width="376" Margin="0,0,10,10"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeaderText}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                            <!-- Categories run down the page, one after another -->
                            <GroupStyle.Panel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </GroupStyle.Panel>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty-search message -->
            <TextBlock x:Name="EmptyMessage" Grid.Column="1"
                       Text="No apps match your search."
                       Foreground="{StaticResource TextMuted}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- ==================== UPDATES VIEW ==================== -->
            <ScrollViewer x:Name="UpdatePanel" Grid.Column="1" Visibility="Collapsed"
                          Margin="28,22,20,10" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <TextBlock Text="Updates" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="StartUPs checks GitHub for new releases. Nothing is sent about you."
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>

                    <!-- Status card -->
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock x:Name="UpdateHeadline" Text="Check for updates"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>

                            <TextBlock x:Name="UpdateDetail" Text=""
                                       FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"/>

                            <ProgressBar x:Name="UpdateProgress" Style="{StaticResource DownloadBar}"
                                         Margin="0,16,0,0" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="CheckUpdateButton" Content="Check for updates"
                                        Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                        Click="CheckUpdate_Click"/>
                                <Button x:Name="DownloadUpdateButton" Content="Download and install"
                                        Style="{StaticResource SuccessButton}" Visibility="Collapsed"
                                        Click="DownloadUpdate_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Release notes -->
                    <TextBlock x:Name="ReleaseNotesHeader" Text="What's new"
                               FontSize="12" FontWeight="Bold" Margin="2,24,0,8"
                               Foreground="{StaticResource TextMuted}" Visibility="Collapsed"/>
                    <Border x:Name="ReleaseNotesCard" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="18,16" Visibility="Collapsed">
                        <TextBlock x:Name="ReleaseNotesText" Text="" TextWrapping="Wrap"
                                   FontSize="12.5" LineHeight="19"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBg}" Padding="24,14">
            <StackPanel>

                <!-- Progress, shown only while a run is in flight -->
                <Grid x:Name="ProgressArea" Visibility="Collapsed" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ProgressLabel" Grid.Row="0" Text=""
                               FontSize="12" Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,8"/>
                    <!-- Maximum is the queue length; Value carries a fraction while
                         the current app downloads, so a single-app run still moves. -->
                    <ProgressBar x:Name="InstallProgress" Grid.Row="1"
                                 Style="{StaticResource DownloadBar}"/>
                </Grid>

                <!-- Optional install root. Blank means every app uses its own default. -->
                <Grid x:Name="LocationArea" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Install to" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="7" Padding="12,7" VerticalAlignment="Center">
                        <TextBlock x:Name="LocationText" Text="Each app's own default location"
                                   FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMuted}"/>
                    </Border>

                    <Button Grid.Column="2" Grid.Row="0" Content="Browse..."
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="BrowseLocation_Click"/>

                    <Button x:Name="ResetLocationButton" Grid.Column="3" Grid.Row="0" Content="Reset"
                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ResetLocation_Click"/>

                    <TextBlock x:Name="LocationNote" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                               FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"
                               Visibility="Collapsed"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SelectionSummary" Grid.Column="0"
                               Text="No apps selected" FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>

                    <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="EssentialsButton" Content="Select Essentials"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="SelectEssentials_Click"/>
                        <Button x:Name="RefreshInstalledButton" Content="Refresh"
                                Style="{StaticResource GhostButton}" Visibility="Collapsed"
                                Margin="0,0,8,0" Click="RefreshInstalled_Click"/>
                        <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="Clear_Click"/>
                        <Button x:Name="InstallButton" Content="Install Selected"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="Install_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
