<Window x:Class="StartUPs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StartUPs"
        mc:Ignorable="d"
        Title="StartUPs" Height="720" Width="1080"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBg}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}">
                        <Run Text="Start"/><Run Text="UPs" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <TextBlock Text="Pick your apps. Install them all at once."
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                    <TextBox x:Name="SearchInput"
                             Style="{StaticResource SearchBox}"
                             TextChanged="SearchInput_TextChanged"/>
                    <TextBlock Text="Search apps..." FontSize="13" Margin="12,0,0,0"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== BODY ==================== -->
        <Grid Grid.Row="1" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
                <ListBox x:Name="CategoryList"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,12"
                         ItemContainerStyle="{StaticResource SidebarItem}"
                         SelectionChanged="CategoryList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- App list -->
            <ScrollViewer Grid.Column="1" Margin="20,16,12,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AppList" Margin="0,0,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource AppCard}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeaderText}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty-search message -->
            <TextBlock x:Name="EmptyMessage" Grid.Column="1"
                       Text="No apps match your search."
                       Foreground="{StaticResource TextMuted}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBg}" Padding="24,14">
            <StackPanel>

                <!-- Progress, shown only while a run is in flight -->
                <Grid x:Name="ProgressArea" Visibility="Collapsed" Margin="0,0,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ProgressLabel" Grid.Row="0" Text=""
                               FontSize="12" Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,8"/>
                    <ProgressBar x:Name="InstallProgress" Grid.Row="1" Minimum="0" Maximum="1" Value="0"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SelectionSummary" Grid.Column="0"
                               Text="No apps selected" FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="EssentialsButton" Content="Select Essentials"
                                Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="SelectEssentials_Click"/>
                        <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="Clear_Click"/>
                        <Button x:Name="InstallButton" Content="Install Selected"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="Install_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
