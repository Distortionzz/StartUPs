<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:StartUPs.Models">

    <!-- ============================ PALETTE ============================ -->
    <Color x:Key="WindowBgColor">#FF16161A</Color>
    <Color x:Key="AccentColor">#FF7B61FF</Color>

    <SolidColorBrush x:Key="WindowBg"   Color="#FF16161A"/>
    <SolidColorBrush x:Key="SidebarBg"  Color="#FF101013"/>
    <SolidColorBrush x:Key="CardBg"     Color="#FF1F1F25"/>
    <SolidColorBrush x:Key="CardHover"  Color="#FF2A2A33"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FF2E2E38"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFECECF1"/>
    <SolidColorBrush x:Key="TextMuted"   Color="#FF9494A5"/>
    <SolidColorBrush x:Key="Accent"      Color="#FF7B61FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF8F79FF"/>
    <SolidColorBrush x:Key="AccentMuted" Color="#FF3A3050"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="FailureBrush" Color="#FFF87171"/>
    <SolidColorBrush x:Key="ProgressTrack" Color="#FF2A2A33"/>

    <!-- Shared converter for showing per-app status text -->
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ============================ GREEN DOWNLOAD BAR ============================ -->
    <!-- Defined up here on purpose: StaticResource resolves top-down, so this must
         appear BEFORE the AppCard style that uses it. -->
    <LinearGradientBrush x:Key="DownloadFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF15A34A" Offset="0"/>
        <GradientStop Color="#FF34D399" Offset="0.6"/>
        <GradientStop Color="#FF6EE7A7" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="DownloadBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#FF15151A" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{StaticResource DownloadFill}" CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF34D399" BlurRadius="10"
                                                      ShadowDepth="0" Opacity="0.75"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SCROLLBAR ============================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF3A3A46" CornerRadius="5" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ SEARCH BOX ============================ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource CardBg}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ SIDEBAR CATEGORY ITEM ============================ -->
    <Style x:Key="SidebarItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentMuted}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ APP CARD (styled CheckBox) ============================ -->
    <Style x:Key="AppCard" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Card" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tick box -->
                            <Border x:Name="Box" Grid.Column="0" Grid.Row="0" Width="20" Height="20"
                                    CornerRadius="5" BorderThickness="2"
                                    BorderBrush="{StaticResource CardBorder}"
                                    Background="Transparent"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <Path x:Name="Tick" Width="11" Height="11" Stretch="Uniform"
                                      Data="M 0,5 L 4,9 L 11,1" Stroke="White" StrokeThickness="2"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>

                            <!-- App icon: brand glyph where we have one, otherwise a letter tile -->
                            <Border Grid.Column="1" Grid.Row="0" Width="38" Height="38"
                                    CornerRadius="10" Background="#FF24242D"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <Grid>
                                    <!-- Real app icon, extracted from the official installer -->
                                    <Image Source="{Binding Bitmap}" Width="27" Height="27"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasBitmap, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Vector brand glyph -->
                                    <Path Data="{Binding Glyph}" Fill="{Binding AccentBrush}"
                                          Stretch="Uniform" Width="19" Height="19"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Last-resort letter tile; no catalog app should reach this -->
                                    <TextBlock Text="{Binding Initial}"
                                               Foreground="{Binding AccentBrush}"
                                               FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Name + description -->
                            <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0"
                                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Live install status -->
                            <TextBlock x:Name="StatusLabel" Grid.Column="3" Grid.Row="0"
                                       Text="{Binding StatusText}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" MinWidth="96" TextAlignment="Right"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>

                            <!-- Green download bar, only while bytes are moving -->
                            <ProgressBar Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                         Style="{StaticResource DownloadBar}"
                                         Value="{Binding DownloadPercent, Mode=OneWay}"
                                         Margin="0,11,0,2"
                                         Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>

                        <!-- Colour the status label by install state -->
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Installing}">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource Accent}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Installed}">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:InstallState.Failed}">
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource FailureBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ BUTTONS ============================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBorder}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Green call-to-action, used when an update is waiting -->
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF06281A"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource DownloadFill}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF34D399" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBorder}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ PROGRESS BAR ============================ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource ProgressTrack}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid>
                            <Rectangle x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ CATEGORY GROUP HEADER ============================ -->
    <Style x:Key="GroupHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="2,14,0,8"/>
    </Style>

</ResourceDictionary>
